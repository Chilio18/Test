# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your-secure-postgres-password

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=your-secure-redis-password

# ─── S3 / MinIO ──────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-secure-minio-secret
S3_BUCKET=revenue-intelligence

# ─── Authentication (OIDC) ───────────────────────────────────────────────────
AUTH_AUTHORITY=https://login.microsoftonline.com/your-tenant-id/v2.0
AUTH_AUDIENCE=revenue-intelligence-api

# ─── AI Providers ────────────────────────────────────────────────────────────
AI_PROVIDER=Mock
# Supported: Mock | OpenAI | Anthropic | AzureOpenAI
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=...
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ─── Encryption ──────────────────────────────────────────────────────────────
# Base64-encoded 32-byte AES key: openssl rand -base64 32
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# ─── Frontend ────────────────────────────────────────────────────────────────
NUXT_PUBLIC_API_BASE=http://localhost:5000
NUXT_PUBLIC_SIGNALR_BASE=http://localhost:5000
FRONTEND_URL=http://localhost:3000
