# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Dealership Configuration
DEALERSHIP_NAME=Premium Auto Sales
DEALERSHIP_ADDRESS=123 Auto Drive, Car City, CC 12345
DEALERSHIP_PHONE=+1-555-AUTO-SALE
DEALERSHIP_EMAIL=sales@premiumauto.example.com
DEALERSHIP_WEBSITE=https://premiumauto.example.com

# Business Hours (24h format)
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_DAYS=Monday,Tuesday,Wednesday,Thursday,Friday,Saturday

# WhatsApp Business API (optional)
WHATSAPP_API_URL=https://api.whatsapp.example.com
WHATSAPP_API_TOKEN=your_whatsapp_token

# Email Configuration (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_password
IMAP_HOST=imap.example.com
IMAP_PORT=993

# Lead Management System API (optional)
LEAD_SYSTEM_API_URL=https://leads.example.com/api
LEAD_SYSTEM_API_KEY=your_lead_system_key

# Database (optional - for persistence)
DATABASE_URL=sqlite:///./car_sales_agent.db
