# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# Publieke basis-URL van deze app (nodig zodat Vapi webhooks kan terugsturen).
# Lokaal ontwikkelen: gebruik bijv. ngrok/cloudflared en vul de tunnel-URL in.
PUBLIC_BASE_URL=https://your-tunnel-url.example.com

# ── Vapi (telefonie + voice agent orchestratie) ───────────────────────────
# Private API key uit je Vapi dashboard (https://dashboard.vapi.ai)
VAPI_API_KEY=vapi_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID van het telefoonnummer in Vapi waarmee uitgebeld wordt
VAPI_PHONE_NUMBER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optioneel: geheim dat Vapi meestuurt in de webhook-header (x-vapi-secret)
VAPI_WEBHOOK_SECRET=change-me

# ── Voice / realtime model ────────────────────────────────────────────────
# Modelnaam is configureerbaar. Voorkeur: OpenAI gpt-realtime-2 (speech-to-speech).
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin

# Pipeline-opbouw (los taalmodel + losse TTS-stem): natuurlijker Nederlands,
# geen afgebroken zinnen. Zie scripts/create-assistant.ts --stack.
PIPELINE_LLM_MODEL=gpt-4o
ELEVENLABS_VOICE_ID=sarah
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ── Mock mode ─────────────────────────────────────────────────────────────
# true  = geen echte calls; de app simuleert een gesprek en leadrapport.
#         Handig om de UI en dataflow te demonstreren zonder Vapi-account.
# false = echte outbound calls via Vapi.
# Zonder VAPI_API_KEY valt de app automatisch terug op mock mode.
MOCK_MODE=true
